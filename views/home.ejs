<% layout("layouts/boilerplate") %>

<div class="text-center mt-5">

    <h1 class="display-4 fw-bold">
        Welcome to StayHub 🏡
    </h1>

    <p class="lead mt-3">
        Discover unique stays, explore amazing destinations,
        and create unforgettable travel experiences.
    </p>

    <hr class="my-4">

    <a
        href="/listings"
        class="btn btn-dark btn-lg"
    >
        Explore Listings
    </a>

    <% if (!currUser) { %>

        <a
            href="/signup"
            class="btn btn-outline-dark btn-lg ms-2"
        >
            Join StayHub
        </a>

    <% } %>

</div>
<h1>All Listings</h1>

<div class="row">

<% for(let listing of allListings) { %>

<a href="/listings/<%= listing._id %>"  class="listing-link">

    <div class="card col-3 m-3">

        <div class="card-body">

            <h5 class="card-title">
                <%= listing.title %>
            </h5>

            <p class="card-text">
                ₹ <%= listing.price %> / night
            </p>

            <p>
                <%= listing.location %>,
                <%= listing.country %>
            </p>

        </div>

    </div>

</a>

</div>

<% } %>

</div>